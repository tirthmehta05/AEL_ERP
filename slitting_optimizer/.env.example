# Copy to .env for local dev (uv reads it via pydantic-settings). .env is
# git-ignored. Production sets these as real environment variables.

# Auth: leave true for local dev (no Entra needed). Set false in prod.
AUTH_DISABLED=true

# Required only when AUTH_DISABLED=false (resource-server token validation):
# the Entra tenant the ERP signs users into, and THIS API's exposed scope.
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=

# Per-lot CP-SAT budget (seconds). 300 = production; lower = faster/looser.
SLIT_TIME_LIMIT=300

# --- Operation parameters (business knobs) ---------------------------------
# Change a value, then `docker compose up -d --force-recreate` (NO rebuild).
# Unset = these defaults = the validated values.
SLIT_KNIFE_MAX=12            # max strips/cuts per coil (slitter knife limit)
SLIT_EDGE_TRIM_MM=3          # minimum edge trim when slitting, mm
SLIT_SCRAP_RATE=34           # ₹/kg scrap sells for
SLIT_SLITTING_COST=4         # ₹/kg slitting cost (slit-mode coils)
SLIT_HOLDING_FACTOR_PCT=95   # month-1 held-stock value (= 5% holding cost)
SLIT_HOLDING_STEP_PCT=5      # extra % lost per additional month (floor: scrap)
SLIT_TARGET_MARGIN=0.08      # margin used by ENGINE max-bid (pre-transport).
                             # User-facing bids in the report use SLIT_BID_TIERS
                             # below (post-transport, comma list of name:margin).
SLIT_BID_TIERS=safe:0.08,compete:0.05,aggressive:0.03,ceiling:0.0
                             # Multi-tier bid display. Each tier = ₹/kg ceiling
                             # for that post-transport net margin. FIRST tier
                             # is "primary": drives bidable flag + profit cols.
                             # 0% = walk-away (never bid above). Override e.g.
                             # SLIT_BID_TIERS=safe:0.10,ceiling:0.0 for 2 tiers.

# --- Width-banded params (narrow ≤ BAND_MM < wide) -------------------------
# The non-_WIDE values above apply to NARROW coils. WIDE values below default
# to narrow when unset (= flat behaviour, validated 39/39 unchanged).
SLIT_BAND_MM=650             # boundary in mm (≤ band = narrow, > band = wide)
# SLIT_KNIFE_MAX_WIDE=19     # uncomment to differentiate wide coils
# SLIT_EDGE_TRIM_MM_WIDE=5
# SLIT_SLITTING_COST_WIDE=1.3

# --- Per-coating salvage (whole coil at lot_start − delta) -----------------
# Hard-to-sell coatings; remove these coatings from regular customer orders.
# Empty = no salvage (validated default).
# SLIT_SALVAGE=C6L:2,C3H:2,C3L:2,UC:4

# Cap on inventory months PER ORDER, applied ONLY to orders whose coatings
# are entirely salvage-eligible. Prevents over-stocking salvage-only
# inventory at premium tier rates when real absorption is limited; overflow
# falls to salvage. Default 999 = effectively no cap = validated behaviour.
# SLIT_MAX_INV_MONTHS=2

# Where sessions + uploads are stored (container mounts a volume here).
SLIT_DATA_DIR=./data
